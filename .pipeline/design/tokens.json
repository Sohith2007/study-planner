{
  "$schema": "focusplan-design-tokens/v1",
  "name": "FocusPlan · Paper & Ink",
  "notes": [
    "Colours are defined once as raw CSS variables (--fp-*) under :root (light) and .dark (dark), then exposed to Tailwind 4 through `@theme inline` as --color-*. Components use only the semantic utilities (bg-bg, bg-surface, text-text, text-muted, bg-primary, ...) and never need `dark:` variants.",
    "Dark mode: P0 adds class `dark` on <html> when matchMedia('(prefers-color-scheme: dark)') matches, and listens for changes. The MVP has no theme toggle UI.",
    "Fonts must be self-hosted (AC-P5-9 forbids requests to any origin other than localhost:5173). Put the woff2 files in app/public/fonts/ and use the @font-face rules in `fontFaces`. If the files cannot be added, the fallback stacks are acceptable.",
    "Subject colours are user data (hex stored on the subject). Apply them with inline style only, for dots, spines, swatches and chart fills. Never use them as text colour."
  ],
  "color": {
    "light": {
      "bg":            { "value": "#F6F4EF", "use": "Page background (warm paper)" },
      "surface":       { "value": "#FFFDF9", "use": "Cards, dialogs, nav bar, inputs" },
      "sunken":        { "value": "#EFECE4", "use": "Wells, skeletons, segmented-control track, past days in Week" },
      "text":          { "value": "#1C1B19", "use": "Primary text (ink)" },
      "muted":         { "value": "#5F5B53", "use": "Secondary text, captions, placeholders" },
      "border":        { "value": "#DDD8CC", "use": "Decorative dividers and card outlines" },
      "border-strong": { "value": "#8A8478", "use": "Input borders and control outlines (3:1 against surface and bg)" },
      "primary":       { "value": "#1F5C4A", "use": "Pine ink. Primary actions, links, active nav, focus ring, New badge" },
      "primary-hover": { "value": "#174A3B", "use": "Hover and pressed state for primary" },
      "primary-soft":  { "value": "#DCEBE4", "use": "Tint for the today column, selected states, New badge background" },
      "on-primary":    { "value": "#FFFFFF", "use": "Text and icons on primary" },
      "accent":        { "value": "#C23E22", "use": "Tomato. Only for the Focus phase: the Start button on /focus, the focus burn line, pomodoro pips, exam-day markers, and the nav timer pill" },
      "accent-hover":  { "value": "#A3321A", "use": "Hover for accent buttons" },
      "accent-soft":   { "value": "#F8E4DC", "use": "Background only (never behind accent text): the exam-day marker in Week and the empty-pip ring" },
      "on-accent":     { "value": "#FFFFFF", "use": "Text on accent" },
      "success":       { "value": "#45700F", "use": "Done status, Covered badge, readiness at 100%" },
      "success-soft":  { "value": "#E4EFD3", "use": "Done and Covered badge background" },
      "warning":       { "value": "#9A5B00", "use": "Partial status, over-capacity banner, capacity overrun" },
      "warning-soft":  { "value": "#FBEBC8", "use": "Partial badge and over-capacity banner background" },
      "danger":        { "value": "#A8233A", "use": "Destructive buttons, validation errors, error states" },
      "danger-hover":  { "value": "#8C1B2F", "use": "Hover for danger buttons" },
      "danger-soft":   { "value": "#F8DEE2", "use": "Error banner and import-error background" },
      "break":         { "value": "#2D5B86", "use": "Break phases on /focus, the Review badge, and the catch-up notice" },
      "break-soft":    { "value": "#DCE7F2", "use": "Focus-page background tint during breaks, Review badge and catch-up notice background" },
      "overlay":       { "value": "rgb(28 27 25 / 0.45)", "use": "Modal backdrop" }
    },
    "dark": {
      "bg":            { "value": "#161512" },
      "surface":       { "value": "#1F1E1A" },
      "sunken":        { "value": "#292823" },
      "text":          { "value": "#EDEAE2" },
      "muted":         { "value": "#A8A294" },
      "border":        { "value": "#34322C" },
      "border-strong": { "value": "#77726A" },
      "primary":       { "value": "#6FC2A6" },
      "primary-hover": { "value": "#8AD3BA" },
      "primary-soft":  { "value": "#1E3B32" },
      "on-primary":    { "value": "#0F2A22" },
      "accent":        { "value": "#F07A5C" },
      "accent-hover":  { "value": "#F4957D" },
      "accent-soft":   { "value": "#3E2219" },
      "on-accent":     { "value": "#1C0B06" },
      "success":       { "value": "#9CCB5E" },
      "success-soft":  { "value": "#26341A" },
      "warning":       { "value": "#E8B04A" },
      "warning-soft":  { "value": "#3D3017" },
      "danger":        { "value": "#F2788C" },
      "danger-hover":  { "value": "#F595A5" },
      "danger-soft":   { "value": "#3E1F25" },
      "break":         { "value": "#7FB0DE" },
      "break-soft":    { "value": "#1C2C3C" },
      "overlay":       { "value": "rgb(0 0 0 / 0.6)" }
    },
    "subjectPresets": [
      { "key": "indigo",  "name": "Indigo",  "value": "#6366F1" },
      { "key": "amber",   "name": "Amber",   "value": "#F59E0B" },
      { "key": "emerald", "name": "Emerald", "value": "#10B981" },
      { "key": "rose",    "name": "Rose",    "value": "#F43F5E" },
      { "key": "sky",     "name": "Sky",     "value": "#0EA5E9" },
      { "key": "violet",  "name": "Violet",  "value": "#8B5CF6" },
      { "key": "orange",  "name": "Orange",  "value": "#F97316" },
      { "key": "slate",   "name": "Slate",   "value": "#64748B" }
    ],
    "chartUnlinked": { "light": "#8A8478", "dark": "#77726A", "use": "Chart series 'Free focus' (sessions with no subject)" }
  },
  "font": {
    "display": { "family": "Fraunces", "stack": "\"Fraunces\", ui-serif, Georgia, \"Times New Roman\", serif", "weights": [400, 600], "use": "Page titles (h1), exam names on dashboard cards, the wordmark, big day numbers" },
    "sans":    { "family": "Instrument Sans", "stack": "\"Instrument Sans\", ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif", "weights": [400, 500, 600], "use": "All UI and body text" },
    "mono":    { "family": "IBM Plex Mono", "stack": "\"IBM Plex Mono\", ui-monospace, \"Cascadia Mono\", Menlo, Consolas, monospace", "weights": [300, 400, 500], "use": "Timer countdown, stat numbers, n/m counts, dates in Week headers. Always with tabular-nums" }
  },
  "fontFaces": [
    "@font-face { font-family: 'Fraunces'; src: url('/fonts/Fraunces-Variable.woff2') format('woff2'); font-weight: 300 700; font-display: swap; }",
    "@font-face { font-family: 'Instrument Sans'; src: url('/fonts/InstrumentSans-Variable.woff2') format('woff2'); font-weight: 400 700; font-display: swap; }",
    "@font-face { font-family: 'IBM Plex Mono'; src: url('/fonts/IBMPlexMono-Light.woff2') format('woff2'); font-weight: 300; font-display: swap; }",
    "@font-face { font-family: 'IBM Plex Mono'; src: url('/fonts/IBMPlexMono-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }",
    "@font-face { font-family: 'IBM Plex Mono'; src: url('/fonts/IBMPlexMono-Medium.woff2') format('woff2'); font-weight: 500; font-display: swap; }"
  ],
  "typeScale": {
    "caption": { "size": "0.75rem",  "lineHeight": "1rem",    "tailwind": "text-caption", "use": "Badges, eyebrows (uppercase, tracking-wide), chart ticks" },
    "small":   { "size": "0.875rem", "lineHeight": "1.25rem", "tailwind": "text-small",   "use": "Meta rows, helper and error text, dense buttons" },
    "body":    { "size": "1rem",     "lineHeight": "1.5rem",  "tailwind": "text-body",    "use": "Default text, inputs, buttons" },
    "lead":    { "size": "1.125rem", "lineHeight": "1.75rem", "tailwind": "text-lead",    "use": "Page subtitles, the Up next topic, the Focus active topic" },
    "heading": { "size": "1.25rem",  "lineHeight": "1.75rem", "tailwind": "text-heading", "use": "Card and section headings (h2)" },
    "title":   { "size": "1.5rem",   "lineHeight": "2rem",    "tailwind": "text-title",   "use": "h1 at 375px, dialog titles, exam card name" },
    "display": { "size": "2.25rem",  "lineHeight": "2.5rem",  "tailwind": "text-display", "use": "h1 at 768px and wider" },
    "stat":    { "size": "2.5rem",   "lineHeight": "1",       "tailwind": "text-stat",    "use": "Dashboard tile numbers, days-left numeral (mono)" },
    "timer":   { "size": "clamp(5.5rem, 20vw, 10rem)", "lineHeight": "1", "letterSpacing": "-0.02em", "tailwind": "text-timer", "use": "The Focus countdown only (mono, weight 300)" }
  },
  "spacing": {
    "base": "0.25rem",
    "tailwindVariable": "--spacing: 0.25rem (Tailwind 4 default; keep it)",
    "allowedSteps": { "0.5": "2px", "1": "4px", "1.5": "6px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px" },
    "rules": [
      "Card padding: p-4 at 375, p-5 at md and up. Dialog padding: p-6.",
      "Gap between stacked cards: gap-4 (375) and gap-6 (md and up).",
      "Page gutter: px-4 (375), px-6 (md), px-8 (xl). Page vertical padding: py-6 (375), py-8 (md and up).",
      "Inline gaps inside rows: gap-2 (tight), gap-3 (default)."
    ]
  },
  "size": {
    "control-sm": { "value": "2.25rem", "tailwind": "h-9",  "use": "Dense desktop buttons inside cards (block actions at md and up)" },
    "control-md": { "value": "2.75rem", "tailwind": "h-11", "use": "Default buttons and inputs (44px touch target)" },
    "control-lg": { "value": "3.5rem",  "tailwind": "h-14", "use": "Start next and timer primary control" },
    "icon-button":{ "value": "2.75rem", "tailwind": "size-11", "use": "Icon-only buttons" }
  },
  "container": {
    "page":  { "value": "72rem", "tailwind": "max-w-page",  "use": "Default page width" },
    "form":  { "value": "48rem", "tailwind": "max-w-form",  "use": "Setup, Settings and Data content column" },
    "focus": { "value": "40rem", "tailwind": "max-w-focus", "use": "Focus page column" },
    "dialog":{ "value": "30rem", "tailwind": "max-w-dialog","use": "Modals" }
  },
  "breakpoints": { "base": "375px (design width, no prefix)", "md": "768px (Tailwind md)", "xl": "1280px (Tailwind xl)", "note": "Use Tailwind 4 defaults. Designs specify base, md: and xl: only; lg: may be used for the Week grid switch (1024px)." },
  "radius": {
    "sm":   { "value": "6px",    "tailwind": "rounded-sm",   "use": "Badges, pips, checkboxes" },
    "md":   { "value": "10px",   "tailwind": "rounded-md",   "use": "Buttons, inputs, block cards" },
    "lg":   { "value": "16px",   "tailwind": "rounded-lg",   "use": "Cards, banners" },
    "xl":   { "value": "24px",   "tailwind": "rounded-xl",   "use": "Dialogs, the Up next card, the timer panel" },
    "full": { "value": "9999px", "tailwind": "rounded-full", "use": "Chips, nav timer pill, segmented control, toggles" }
  },
  "shadow": {
    "light": {
      "card":    "0 1px 0 rgb(28 27 25 / 0.04), 0 1px 3px rgb(28 27 25 / 0.06)",
      "raised":  "0 6px 16px -4px rgb(28 27 25 / 0.12), 0 2px 4px rgb(28 27 25 / 0.05)",
      "overlay": "0 24px 48px -12px rgb(28 27 25 / 0.28)"
    },
    "dark": {
      "card":    "0 1px 0 rgb(0 0 0 / 0.3)",
      "raised":  "0 6px 16px -4px rgb(0 0 0 / 0.5)",
      "overlay": "0 24px 48px -12px rgb(0 0 0 / 0.7)"
    },
    "tailwind": { "card": "shadow-card", "raised": "shadow-raised", "overlay": "shadow-overlay" }
  },
  "motion": {
    "duration": {
      "fast": { "value": "150ms", "tailwind": "duration-150", "use": "Hover colour, focus ring, badge changes" },
      "base": { "value": "200ms", "tailwind": "duration-200", "use": "Menus, toasts in and out, drag highlight" },
      "slow": { "value": "300ms", "tailwind": "duration-300", "use": "Dialogs, banners expanding" },
      "calm": { "value": "500ms", "tailwind": "duration-500", "use": "Focus page phase tint change and burn-line reset" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)",    "tailwind": "ease-standard" },
      "exit":     { "value": "cubic-bezier(0.4, 0, 1, 1)",    "tailwind": "ease-exit" },
      "calm":     { "value": "cubic-bezier(0.37, 0, 0.63, 1)", "tailwind": "ease-calm" }
    },
    "reducedMotion": "Under prefers-reduced-motion: reduce, remove transforms and pulses (motion-reduce:transition-none, motion-reduce:animate-none). Colour fades may stay at duration-150."
  },
  "zIndex": { "nav": 30, "statusBar": 20, "menu": 40, "overlay": 50, "toast": 60 },
  "cssVariables": {
    ":root": {
      "--fp-bg": "#F6F4EF",
      "--fp-surface": "#FFFDF9",
      "--fp-sunken": "#EFECE4",
      "--fp-text": "#1C1B19",
      "--fp-muted": "#5F5B53",
      "--fp-border": "#DDD8CC",
      "--fp-border-strong": "#8A8478",
      "--fp-primary": "#1F5C4A",
      "--fp-primary-hover": "#174A3B",
      "--fp-primary-soft": "#DCEBE4",
      "--fp-on-primary": "#FFFFFF",
      "--fp-accent": "#C23E22",
      "--fp-accent-hover": "#A3321A",
      "--fp-accent-soft": "#F8E4DC",
      "--fp-on-accent": "#FFFFFF",
      "--fp-success": "#45700F",
      "--fp-success-soft": "#E4EFD3",
      "--fp-warning": "#9A5B00",
      "--fp-warning-soft": "#FBEBC8",
      "--fp-danger": "#A8233A",
      "--fp-danger-hover": "#8C1B2F",
      "--fp-danger-soft": "#F8DEE2",
      "--fp-break": "#2D5B86",
      "--fp-break-soft": "#DCE7F2",
      "--fp-overlay": "rgb(28 27 25 / 0.45)",
      "--fp-chart-unlinked": "#8A8478",
      "--fp-shadow-card": "0 1px 0 rgb(28 27 25 / 0.04), 0 1px 3px rgb(28 27 25 / 0.06)",
      "--fp-shadow-raised": "0 6px 16px -4px rgb(28 27 25 / 0.12), 0 2px 4px rgb(28 27 25 / 0.05)",
      "--fp-shadow-overlay": "0 24px 48px -12px rgb(28 27 25 / 0.28)",
      "color-scheme": "light"
    },
    ".dark": {
      "--fp-bg": "#161512",
      "--fp-surface": "#1F1E1A",
      "--fp-sunken": "#292823",
      "--fp-text": "#EDEAE2",
      "--fp-muted": "#A8A294",
      "--fp-border": "#34322C",
      "--fp-border-strong": "#77726A",
      "--fp-primary": "#6FC2A6",
      "--fp-primary-hover": "#8AD3BA",
      "--fp-primary-soft": "#1E3B32",
      "--fp-on-primary": "#0F2A22",
      "--fp-accent": "#F07A5C",
      "--fp-accent-hover": "#F4957D",
      "--fp-accent-soft": "#3E2219",
      "--fp-on-accent": "#1C0B06",
      "--fp-success": "#9CCB5E",
      "--fp-success-soft": "#26341A",
      "--fp-warning": "#E8B04A",
      "--fp-warning-soft": "#3D3017",
      "--fp-danger": "#F2788C",
      "--fp-danger-hover": "#F595A5",
      "--fp-danger-soft": "#3E1F25",
      "--fp-break": "#7FB0DE",
      "--fp-break-soft": "#1C2C3C",
      "--fp-overlay": "rgb(0 0 0 / 0.6)",
      "--fp-chart-unlinked": "#77726A",
      "--fp-shadow-card": "0 1px 0 rgb(0 0 0 / 0.3)",
      "--fp-shadow-raised": "0 6px 16px -4px rgb(0 0 0 / 0.5)",
      "--fp-shadow-overlay": "0 24px 48px -12px rgb(0 0 0 / 0.7)",
      "color-scheme": "dark"
    }
  },
  "tailwindTheme": {
    "directive": "@theme inline",
    "variables": {
      "--color-bg": "var(--fp-bg)",
      "--color-surface": "var(--fp-surface)",
      "--color-sunken": "var(--fp-sunken)",
      "--color-text": "var(--fp-text)",
      "--color-muted": "var(--fp-muted)",
      "--color-border": "var(--fp-border)",
      "--color-border-strong": "var(--fp-border-strong)",
      "--color-primary": "var(--fp-primary)",
      "--color-primary-hover": "var(--fp-primary-hover)",
      "--color-primary-soft": "var(--fp-primary-soft)",
      "--color-on-primary": "var(--fp-on-primary)",
      "--color-accent": "var(--fp-accent)",
      "--color-accent-hover": "var(--fp-accent-hover)",
      "--color-accent-soft": "var(--fp-accent-soft)",
      "--color-on-accent": "var(--fp-on-accent)",
      "--color-success": "var(--fp-success)",
      "--color-success-soft": "var(--fp-success-soft)",
      "--color-warning": "var(--fp-warning)",
      "--color-warning-soft": "var(--fp-warning-soft)",
      "--color-danger": "var(--fp-danger)",
      "--color-danger-hover": "var(--fp-danger-hover)",
      "--color-danger-soft": "var(--fp-danger-soft)",
      "--color-break": "var(--fp-break)",
      "--color-break-soft": "var(--fp-break-soft)",
      "--color-overlay": "var(--fp-overlay)",
      "--color-chart-unlinked": "var(--fp-chart-unlinked)",
      "--font-display": "\"Fraunces\", ui-serif, Georgia, \"Times New Roman\", serif",
      "--font-sans": "\"Instrument Sans\", ui-sans-serif, system-ui, \"Segoe UI\", Roboto, sans-serif",
      "--font-mono": "\"IBM Plex Mono\", ui-monospace, \"Cascadia Mono\", Menlo, Consolas, monospace",
      "--text-caption": "0.75rem",
      "--text-caption--line-height": "1rem",
      "--text-small": "0.875rem",
      "--text-small--line-height": "1.25rem",
      "--text-body": "1rem",
      "--text-body--line-height": "1.5rem",
      "--text-lead": "1.125rem",
      "--text-lead--line-height": "1.75rem",
      "--text-heading": "1.25rem",
      "--text-heading--line-height": "1.75rem",
      "--text-title": "1.5rem",
      "--text-title--line-height": "2rem",
      "--text-display": "2.25rem",
      "--text-display--line-height": "2.5rem",
      "--text-stat": "2.5rem",
      "--text-stat--line-height": "1",
      "--text-timer": "clamp(5.5rem, 20vw, 10rem)",
      "--text-timer--line-height": "1",
      "--text-timer--letter-spacing": "-0.02em",
      "--radius-sm": "6px",
      "--radius-md": "10px",
      "--radius-lg": "16px",
      "--radius-xl": "24px",
      "--shadow-card": "var(--fp-shadow-card)",
      "--shadow-raised": "var(--fp-shadow-raised)",
      "--shadow-overlay": "var(--fp-shadow-overlay)",
      "--ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
      "--ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
      "--ease-calm": "cubic-bezier(0.37, 0, 0.63, 1)",
      "--container-page": "72rem",
      "--container-form": "48rem",
      "--container-focus": "40rem",
      "--container-dialog": "30rem"
    }
  },
  "indexCssSnippet": "@import \"tailwindcss\";\n@custom-variant dark (&:where(.dark, .dark *));\n/* :root and .dark blocks from cssVariables go here */\n@theme inline { /* variables from tailwindTheme.variables */ }\n@layer base {\n  html { background: var(--fp-bg); color: var(--fp-text); font-family: var(--font-sans); -webkit-font-smoothing: antialiased; }\n  :focus-visible { outline: 2px solid var(--fp-primary); outline-offset: 2px; }\n  .tabular { font-variant-numeric: tabular-nums; }\n}"
}
